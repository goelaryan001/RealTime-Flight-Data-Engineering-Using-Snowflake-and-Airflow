# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# ---------- POSTGRES (Airflow's metadata DB, local to docker-compose only) ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# ---------- AIRFLOW ADMIN (login for the localhost:8080 webserver UI) ----------
AIRFLOW_ADMIN_USER=changeme
AIRFLOW_ADMIN_FIRSTNAME=changeme
AIRFLOW_ADMIN_LASTNAME=changeme
AIRFLOW_ADMIN_EMAIL=changeme@example.com
AIRFLOW_ADMIN_PASSWORD=changeme

# ---------- AIRFLOW FERNET KEY (encrypts Connection passwords at rest in Postgres) ----------
# Generate your own: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme

# ---------- SNOWFLAKE ----------
# Not read by docker-compose — Snowflake credentials are set up separately as
# an Airflow Connection (Admin > Connections > flight_snowflake) through the
# webserver UI once it's running, not through this file. See README.md.
